# Defensive: this repo holds only public policy docs, but these patterns
# protect against accidentally committing secrets or local artifacts.

# Secrets
*.env
.env*
*.key
*.pem
*.cert
*.crt
*token*.json
*secret*.json
*credentials*.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Build / cache / language-specific (defensive — no code expected here)
node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Logs
*.log
logs/
